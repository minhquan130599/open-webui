WEBUI_PORT=8000
WEBUI_SECRET_KEY='

# Chỉ dùng chữ và số (nằm trong URL kết nối)
POSTGRES_PASSWORD=

# MinIO: user ít nhất 3 ký tự, mật khẩu ít nhất 8 ký tự, chỉ dùng chữ và số
S3_ACCESS_KEY=
S3_SECRET_KEY=

# API cloud chạy Qwen (OpenAI-compatible)
OPENAI_API_BASE_URL=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------------------------
# Đăng nhập Google / Microsoft (chỉ dùng khi chạy kèm docker-compose.oauth.yaml)
# Bỏ dấu # ở 2 dòng COMPOSE_* để mọi lệnh docker compose (kể cả update.ps1) tự nạp file OAuth.
# COMPOSE_PATH_SEPARATOR=;
# COMPOSE_FILE=docker-compose.yaml;docker-compose.oauth.yaml

# Địa chỉ HTTPS công khai, không có dấu / ở cuối
PUBLIC_URL=https://chat.congty.vn
# Tên miền email được phép (cách nhau bằng dấu phẩy); * = mọi email
OAUTH_ALLOWED_DOMAINS=congty.vn
# pending = admin duyệt người mới; user = vào dùng ngay
DEFAULT_USER_ROLE=pending
# false = chỉ đăng nhập bằng Google/Microsoft (kiểm tra admin đăng nhập được trước khi tắt)
ENABLE_LOGIN_FORM=true

# Để trống cặp nào thì nút đăng nhập đó không hiện
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CLIENT_TENANT_ID=
