WEBUI_PORT=8000
WEBUI_SECRET_KEY=

# Chỉ dùng chữ và số (nằm trong URL kết nối)
POSTGRES_PASSWORD=

# MinIO: user ít nhất 3 ký tự, mật khẩu ít nhất 8 ký tự, chỉ dùng chữ và số
S3_ACCESS_KEY=
S3_SECRET_KEY=

# API cloud chạy Qwen (OpenAI-compatible)
OPENAI_API_BASE_URL=
OPENAI_API_KEY=
# public = model của kết nối đầu tiên (OPENAI_API_BASE_URL, kể cả khi sửa URL trong Admin) tự công khai cho mọi
# người dùng khi xuất hiện lần đầu; admin vẫn đổi quyền từng model được. Để trống = chỉ admin thấy tới khi cấu hình.
DEFAULT_MODEL_ACCESS=public

# Open Terminal: AI tạo file Word/Excel/PDF. Khóa bí mật dài, ngẫu nhiên (vd: openssl rand -hex 32)
TERMINAL_API_KEY=
# ID kết nối Terminal đặt trong Admin > Tích hợp > Terminal; để trống = AI trong kênh không dùng Terminal
CHANNEL_MODEL_TERMINAL_ID=ncs-terminal
# Ai được dùng Terminal (chỉ áp dụng ở lần tạo kết nối đầu tiên). Mặc định: mọi người dùng; [] = chỉ admin.
# Mọi người dùng: [{"principal_type":"user","principal_id":"*","permission":"read"}]
TERMINAL_ACCESS_GRANTS=[{"principal_type":"user","principal_id":"*","permission":"read"}]

# ---------------------------------------------------------------------------------------------
# Đăng nhập Google / Microsoft (chỉ dùng khi chạy kèm docker-compose.oauth.yaml)
# Bỏ dấu # ở 2 dòng COMPOSE_* để mọi lệnh docker compose (kể cả update.ps1) tự nạp file OAuth.
# COMPOSE_PATH_SEPARATOR=;
# COMPOSE_FILE=docker-compose.yaml;docker-compose.oauth.yaml

# Địa chỉ HTTPS công khai, không có dấu / ở cuối
PUBLIC_URL=https://chat.congty.vn
# Tên miền email được phép (cách nhau bằng dấu phẩy); * = mọi email
OAUTH_ALLOWED_DOMAINS=congty.vn
# pending = admin duyệt người mới; user = vào dùng ngay
DEFAULT_USER_ROLE=pending
# false = chỉ đăng nhập bằng Google/Microsoft (kiểm tra admin đăng nhập được trước khi tắt)
ENABLE_LOGIN_FORM=true

# Để trống cặp nào thì nút đăng nhập đó không hiện
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CLIENT_TENANT_ID=

# Trang giám sát hiệu năng (service monitor, cổng 127.0.0.1:MONITOR_PORT).
# MONITOR_API_KEY: khóa nội bộ giữa trang giám sát và NCS AI (chuỗi ngẫu nhiên dài, vd: openssl rand -hex 32).
# MONITOR_PASSWORD: mật khẩu đăng nhập trang giám sát (bắt buộc; để trống thì trang không hoạt động).
MONITOR_PORT=8090
MONITOR_USERNAME=admin
MONITOR_PASSWORD=
MONITOR_API_KEY=
# Số ngày giữ số liệu giám sát
PERF_RETENTION_DAYS=90

# ---------------------------------------------------------------------------------------------------------
# Kiến thức (RAG): model embedding. CHỈ áp dụng ở lần cài đầu (database chưa có cấu hình này).
# Đã cấu hình trong Admin > Cài đặt > Tài liệu thì giao diện được ưu tiên; xem docker/HUONG-DAN-EMBEDDING.md.
# ---------------------------------------------------------------------------------------------------------
# true = chỉ trích xuất chữ, không tạo embedding (tải lên nhanh, không tìm theo ngữ nghĩa). false = dùng embedding.
BYPASS_EMBEDDING_AND_RETRIEVAL=false
# openai = gọi API embedding dạng OpenAI (/v1/embeddings): container TEI, pod RunPod (vLLM), OpenAI...
# để trống = chạy model ngay trong container NCS AI (mỗi worker nạp một bản, bge-m3 ~2,3 GB/worker, không nên)
RAG_EMBEDDING_ENGINE=openai
RAG_EMBEDDING_MODEL=BAAI/bge-m3
# Địa chỉ API embedding, kết thúc bằng /v1. Ví dụ:
#   container trên cùng server: http://embedding:80/v1
#   pod RunPod:                 https://<pod-id>-8000.proxy.runpod.net/v1
RAG_EMBEDDING_BASE_URL=
# Khóa API của dịch vụ embedding (TEI không cần khóa thì điền bất kỳ, vd: none)
RAG_EMBEDDING_API_KEY=
# Số đoạn gửi mỗi lần gọi API (càng lớn càng nhanh khi tải tài liệu dài)
RAG_EMBEDDING_BATCH_SIZE=32
# Chia đoạn và số đoạn lấy ra khi hỏi
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
RAG_TOP_K=8
# Tìm kết hợp ngữ nghĩa + từ khóa (BM25)
ENABLE_RAG_HYBRID_SEARCH=false
